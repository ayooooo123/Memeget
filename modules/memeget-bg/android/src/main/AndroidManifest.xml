<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Keep-alive foreground service for paced background indexing. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <!-- Ask Play Store to prefetch the ML Kit subject segmentation model at
         install time. This is the cheap path and it covers Play Store installs
         only — a sideloaded APK (which is how this app is installed) never gets
         it, so MemeStillSubjectSegmenter also requests the optional module
         explicitly through ModuleInstallClient. Both, not either: the manifest
         declaration means the model is usually already there, and the explicit
         request means the feature still works when it is not. -->
    <meta-data
      android:name="com.google.mlkit.vision.DEPENDENCIES"
      android:value="subject_segment" />

    <service
      android:name="expo.modules.memegetbg.KeepAliveService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <!-- Serves clipboard-staged files (videos) as content:// uris. Not exported:
         the paste target gets access through the clipboard framework's uri
         grant, which requires grantUriPermissions. -->
    <provider
      android:name="expo.modules.memegetbg.MemeClipFileProvider"
      android:authorities="${applicationId}.memegetclip"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/memeget_clip_paths" />
    </provider>
  </application>
</manifest>
