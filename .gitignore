# Local dependencies and retired Expo build artifacts; keep old installs and
# untracked generated trees out of the native-only repository.
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# Native generated / build directories (native/ and ios/ source trees are tracked!)
/android
**/android/build/
/ios/build/
/ios/DerivedData/
/ios/**/xcuserdata/
# Metro
.metro-health-check*

# Misc
*.log
.DS_Store
*.orig.*

# Local env
.env*.local

# Python bytecode from the dev tooling
__pycache__/

# Real-library exports for the eval loops — a personal collection, never committed
tools/eval/described.json
tools/eval/collection-manifest.json
.worktrees/

# Standalone native Android build products
/native/.gradle/
/native/.kotlin/
/native/**/build/
/native/**/.cxx/
/native/local.properties

# Local Immich credentials & extracted personal camera-roll artifacts (NEVER committed)
.immich.env
.env.immich
/immich-out/
/tools/immich-extract/build/
